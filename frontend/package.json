{
  "name": "convertfix-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
